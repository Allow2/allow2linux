[Flatpak Ref]
Title=Allow2 Parental Freedom
Name=com.allow2.allow2linux
Branch=stable
Url=https://get.allow2.com/steamdeck/stable/
RuntimeRepo=https://flathub.org/repo/flathub.flatpakrepo
IsRuntime=false
# STABLE / PRODUCTION channel. The launcher baked into this build is
# production-locked (ALLOW2_PRODUCTION=1 + NODE_ENV=production) so the Allow2 SDK
# can NEVER attach to staging. Published by:  ./scripts/publish.sh production
# (branch `stable`, R2 prefix /steamdeck/stable/).
#
# `Branch=stable` MUST match the branch flatpak-builder exports for this channel
# (publish.sh passes --default-branch=stable). The tester/user double-clicks this
# file (or runs `flatpak install --from com.allow2.allow2linux.flatpakref`); the
# remote points at the stable R2 prefix and installs the production build.
#
# For the INTERNAL BETA (staging) build, use com.allow2.allow2linux-beta.flatpakref.
#
# NOTE: no GPGKey line => this remote is added with gpg-verify=false (acceptable
# over HTTPS for now). For a wider public rollout, sign the ostree repo
# (flatpak build-sign / --gpg-sign) and paste the base64 public key here as
# `GPGKey=...`.
