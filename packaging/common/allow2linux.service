# systemd --user unit shipped by the allow2linux .deb / .rpm packages.
#
# Installed system-wide to /usr/lib/systemd/user/allow2linux.service so it is
# available to every user, and enabled for all users by the package postinstall
# via `systemctl --global enable allow2linux.service`. Each user's linger is
# enabled on first launch by the daemon (src/first-run.js) or manually with
# `loginctl enable-linger "$USER"`.
#
# Unlike the Flatpak build, deb/rpm updates arrive through apt/dnf, so there is
# NO auto-update timer here (the Flatpak-only allow2linux-update.{service,timer}
# are intentionally not shipped in these packages).
#
# ExecStart is the production-locked launcher (/usr/bin/allow2linux) which bakes
# ALLOW2_PRODUCTION=1 — the public packages are production-only.
#
# PRODUCTION-LOCK (packaged installs): on first launch the daemon's first-run
# (src/first-run.js) writes a per-user copy of this unit to
# ~/.config/systemd/user/allow2linux.service — which SHADOWS this system unit
# (user-config unit path outranks /usr/lib/systemd/user). first-run.js detects a
# packaged prod install (/usr/bin/allow2linux present AND daemon running from
# /usr/…) and sets that per-user ExecStart to /usr/bin/allow2linux — the same
# production-locked launcher — so ALLOW2_PRODUCTION=1 is always re-exported and
# ALLOW2_ENV=staging can NEVER reattach a packaged install to staging. The
# earlier gap (node-direct ExecStart dropping the flag) is closed.

[Unit]
Description=Allow2 Parental Freedom for Linux
Documentation=https://github.com/Allow2/allow2linux
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/allow2linux
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=default.target
