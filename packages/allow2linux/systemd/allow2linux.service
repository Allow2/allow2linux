# Canonical `systemd --user` unit for allow2linux.
#
# Install to ~/.config/systemd/user/allow2linux.service, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now allow2linux.service
#   loginctl enable-linger "$USER"      # start at boot without an interactive login
#
# The daemon auto-runs those three steps on first launch (see src/first-run.js);
# this file is the authoritative unit they install.
#
# ExecStart targets the Flatpak install (the shipped layout). The channel is
# baked into the Flatpak launcher at build time (see flatpak/gen-launcher.sh):
#   stable channel → ALLOW2_PRODUCTION=1 baked → hard-pinned to production.
#   beta channel   → ALLOW2_ENV=staging baked (prod flag omitted) → staging, for
#                    the internal tester only. Either way the endpoint is fixed by
#                    the build, not by any ALLOW2_ENV in the runtime environment.
#
# For the non-Flatpak dev layout (direct Node), first-run rewrites ExecStart to
# the resolved `node .../src/index.js` path instead — see src/first-run.js.

[Unit]
Description=Allow2 Parental Freedom for Linux
Documentation=https://github.com/Allow2/allow2linux
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/flatpak run com.allow2.allow2linux
Restart=always
RestartSec=5
# Give the overlay/child a moment on shutdown, then hard-stop.
TimeoutStopSec=10

[Install]
WantedBy=default.target
