[Flatpak Ref]
Title=Allow2 Parental Freedom (Beta)
Name=com.allow2.allow2linux
Branch=beta
Url=https://get.allow2.com/steamdeck/staging/
RuntimeRepo=https://flathub.org/repo/flathub.flatpakrepo
IsRuntime=false
# GPGKey= injected at publish time by scripts/publish.sh (do NOT hardcode a key
# here — the placeholder line below is replaced with the base64 public key of
# ALLOW2_FLATPAK_GPG_KEYID in the copy uploaded to R2). Keep this line present so
# the structure is obvious; the committed value stays empty (public key only ever
# lands in the PUBLISHED ref, never in git).
GPGKey=
# INTERNAL BETA / STAGING channel — for the internal tester ONLY.
#
# This build's launcher DELIBERATELY targets STAGING: it bakes ALLOW2_ENV=staging
# and OMITS the production flag, so the Allow2 SDK attaches to
# staging-api.allow2.com. Published by:  ./scripts/publish.sh staging
# (branch `beta`, R2 prefix /steamdeck/staging/).
#
# SECURITY: this staging build must stay on the beta channel and must NEVER be
# promoted to stable / Flathub. The public/stable release uses
# com.allow2.allow2linux.flatpakref (Branch=stable), whose launcher is
# production-locked so staging is unreachable.
#
# `Branch=beta` MUST match the branch flatpak-builder exports for this channel
# (publish.sh passes --default-branch=beta). The tester double-clicks this file
# (or runs `flatpak install --from com.allow2.allow2linux-beta.flatpakref`); the
# remote points at the staging R2 prefix and installs the beta build. Subsequent
# `flatpak update` (and the auto-update timer) pull new betas from the same URL.
#
# SIGNING: the staging ostree repo is GPG-signed (publish.sh passes --gpg-sign to
# both flatpak-builder and build-update-repo). The matching public key is injected
# into the GPGKey= line above at publish time from ALLOW2_FLATPAK_GPG_KEYID, so the
# remote is added with gpg-verify=TRUE. This is REQUIRED, not optional: without a
# GPGKey `flatpak install --from <ref>` refuses the repo ("Can't pull from
# untrusted non-gpg verified remote") — even for a single internal tester.
